// Rise – schermata di avvio: logo con il portale di luce, una scintilla che scorre e il tempo di avvio.
// La risoluzione può cambiare durante l'avvio (quando parte il driver della scheda video):
// per questo tutte le posizioni vengono ricalcolate quando cambiano larghezza o altezza.

Window.SetBackgroundTopColor(0.01, 0.02, 0.06);
Window.SetBackgroundBottomColor(0.03, 0.08, 0.22);

bg0 = Image("bg.png");
logo0 = Image("logo.png");
bar0 = Image("bar.png");
spark0 = Image("spark.png");
tag0 = Image("tagline.png");

bg_s = Sprite();    bg_s.SetZ(-100);
logo_s = Sprite();  logo_s.SetZ(10); logo_s.SetOpacity(0);
bar_s = Sprite();   bar_s.SetZ(10);
spark_s = Sprite(); spark_s.SetZ(20);
tag_s = Sprite();   tag_s.SetZ(10); tag_s.SetOpacity(0);
time_s = Sprite();  time_s.SetZ(30);
msg_s = Sprite();   msg_s.SetZ(30);
pw_s = Sprite();    pw_s.SetZ(30);

lw = 0; lh = 0;
fun layout() {
  W = Window.GetWidth();
  H = Window.GetHeight();
  if (W < 1 || H < 1) return;
  lw = W; lh = H;
  k = H / 1080;
  if (W / 1920 < k) k = W / 1920;   // schermi stretti o verticali
  if (k > 1.6) k = 1.6;
  if (k < 0.35) k = 0.35;
  cx = Window.GetX() + W / 2;
  cy = Window.GetY() + H * 0.42;

  bg_s.SetImage(bg0.Scale(W, H));
  bg_s.SetPosition(Window.GetX(), Window.GetY(), -100);

  logo = logo0.Scale(logo0.GetWidth() * k, logo0.GetHeight() * k);
  logo_s.SetImage(logo);
  logo_s.SetPosition(cx - logo.GetWidth() / 2, cy - logo.GetHeight() / 2, 10);

  bar = bar0.Scale(bar0.GetWidth() * k, bar0.GetHeight() * k);
  bar_s.SetImage(bar);
  by = cy + logo.GetHeight() / 2 + 40 * k;
  bar_s.SetPosition(cx - bar.GetWidth() / 2, by, 10);

  spark = spark0.Scale(spark0.GetWidth() * k, spark0.GetHeight() * k);
  spark_s.SetImage(spark);

  tag = tag0.Scale(tag0.GetWidth() * k, tag0.GetHeight() * k);
  tag_s.SetImage(tag);
  tag_s.SetPosition(cx - tag.GetWidth() / 2, by + 40 * k, 10);
}
layout();

// contatore del tempo di avvio (la schermata si aggiorna 50 volte al secondo)
fun show_time(frames) {
  tenths = Math.Int(frames / 5);
  secs = Math.Int(tenths / 10);
  dec = tenths - secs * 10;
  img = Image.Text("avvio  " + secs + "," + dec + " s", 0.62, 0.74, 1, 1, "Sans 15");
  time_s.SetImage(img);
  time_s.SetPosition(cx - img.GetWidth() / 2, by + 110 * k, 30);
}

t = 0;
fun refresh_callback() {
  if (Window.GetWidth() != lw || Window.GetHeight() != lh) layout();
  if (lw < 1) return;
  t++;
  if (t % 5 == 0) show_time(t);
  // il logo compare dal buio, poi "respira" piano
  if (t < 40) logo_s.SetOpacity(t / 40);
  else logo_s.SetOpacity(0.88 + 0.12 * Math.Sin(t * 0.045));
  // la scintilla va da sinistra a destra lungo la linea, ogni 1,6 secondi
  p = (t % 80) / 80;
  sx = cx - bar.GetWidth() / 2 + p * (bar.GetWidth() - spark.GetWidth());
  spark_s.SetPosition(sx, by, 20);
  spark_s.SetOpacity(Math.Sin(p * 3.14159));
  if (t > 30 && t < 90) tag_s.SetOpacity((t - 30) / 60);
  if (t >= 90) tag_s.SetOpacity(1);
}
Plymouth.SetRefreshFunction(refresh_callback);

// messaggi e password (es. dischi cifrati): testo semplice in basso
fun message_callback(text) {
  msg_s.SetImage(Image.Text(text, 0.8, 0.86, 1));
  msg_s.SetPosition(cx - msg_s.GetImage().GetWidth() / 2, Window.GetY() + lh * 0.9, 30);
}
Plymouth.SetMessageFunction(message_callback);

fun display_password_callback(prompt, bullets) {
  s = prompt + "  ";
  for (i = 0; i < bullets; i++) s += "•";
  pw_s.SetImage(Image.Text(s, 1, 1, 1));
  pw_s.SetPosition(cx - pw_s.GetImage().GetWidth() / 2, Window.GetY() + lh * 0.85, 30);
  pw_s.SetOpacity(1);
}
fun display_normal_callback() { pw_s.SetOpacity(0); }
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
