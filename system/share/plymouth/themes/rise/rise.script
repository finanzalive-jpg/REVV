// Rise – schermata di avvio: logo con il portale di luce, una scintilla che scorre e il tempo di avvio
W = Window.GetWidth();
H = Window.GetHeight();
k = H / 1080;
if (k > 1.6) k = 1.6;

Window.SetBackgroundTopColor(0.01, 0.02, 0.06);
Window.SetBackgroundBottomColor(0.03, 0.08, 0.22);

bg = Image("bg.png").Scale(W, H);
bg_s = Sprite(bg);
bg_s.SetZ(-100);

cx = W / 2;
cy = H * 0.42;

logo = Image("logo.png");
logo = logo.Scale(logo.GetWidth() * k, logo.GetHeight() * k);
logo_s = Sprite(logo);
logo_s.SetPosition(cx - logo.GetWidth() / 2, cy - logo.GetHeight() / 2, 10);
logo_s.SetOpacity(0);

// linea di luce sotto il logo, con una scintilla che la percorre
bar = Image("bar.png");
bar = bar.Scale(bar.GetWidth() * k, bar.GetHeight() * k);
bar_s = Sprite(bar);
by = cy + logo.GetHeight() / 2 + 40 * k;
bar_s.SetPosition(cx - bar.GetWidth() / 2, by, 10);

spark = Image("spark.png");
spark = spark.Scale(spark.GetWidth() * k, spark.GetHeight() * k);
spark_s = Sprite(spark);
spark_s.SetZ(20);

tag = Image("tagline.png");
tag = tag.Scale(tag.GetWidth() * k, tag.GetHeight() * k);
tag_s = Sprite(tag);
tag_s.SetPosition(cx - tag.GetWidth() / 2, by + 40 * k, 10);
tag_s.SetOpacity(0);

// contatore del tempo di avvio (la schermata si aggiorna 50 volte al secondo)
time_s = Sprite();
time_s.SetZ(30);
fun show_time(frames) {
  tenths = Math.Int(frames / 5);
  secs = Math.Int(tenths / 10);
  dec = tenths - secs * 10;
  img = Image.Text("avvio  " + secs + "," + dec + " s", 0.62, 0.74, 1, 1, "Sans 15");
  time_s.SetImage(img);
  time_s.SetPosition(cx - img.GetWidth() / 2, by + 110 * k, 30);
}

t = 0;
fun refresh_callback() {
  t++;
  if (t % 5 == 0) show_time(t);
  // il logo compare dal buio, poi "respira" piano
  if (t < 40) logo_s.SetOpacity(t / 40);
  else logo_s.SetOpacity(0.88 + 0.12 * Math.Sin(t * 0.045));
  // la scintilla va da sinistra a destra lungo la linea, ogni 1,6 secondi
  p = (t % 80) / 80;
  sx = cx - bar.GetWidth() / 2 + p * (bar.GetWidth() - spark.GetWidth());
  spark_s.SetPosition(sx, by, 20);
  spark_s.SetOpacity(Math.Sin(p * 3.14159));
  if (t > 30 && t < 90) tag_s.SetOpacity((t - 30) / 60);
  if (t >= 90) tag_s.SetOpacity(1);
}
Plymouth.SetRefreshFunction(refresh_callback);

// messaggi e password (es. dischi cifrati): testo semplice in basso
msg_s = Sprite();
fun message_callback(text) {
  msg_s.SetImage(Image.Text(text, 0.8, 0.86, 1));
  msg_s.SetPosition(cx - msg_s.GetImage().GetWidth() / 2, H * 0.9, 30);
}
Plymouth.SetMessageFunction(message_callback);

pw_s = Sprite();
fun display_password_callback(prompt, bullets) {
  s = prompt + "  ";
  for (i = 0; i < bullets; i++) s += "•";
  pw_s.SetImage(Image.Text(s, 1, 1, 1));
  pw_s.SetPosition(cx - pw_s.GetImage().GetWidth() / 2, H * 0.85, 30);
  pw_s.SetOpacity(1);
}
fun display_normal_callback() { pw_s.SetOpacity(0); }
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
