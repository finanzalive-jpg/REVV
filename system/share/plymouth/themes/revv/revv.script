// Revv – schermata di avvio: sfondo, sfera con il contagiri, anello di luce che gira
W = Window.GetWidth();
H = Window.GetHeight();
k = H / 1080;
if (k > 1.6) k = 1.6;

Window.SetBackgroundTopColor(0.08, 0.31, 0.43);
Window.SetBackgroundBottomColor(0.04, 0.13, 0.21);

bg = Image("bg.png").Scale(W, H);
bg_s = Sprite(bg);
bg_s.SetZ(-100);

logo = Image("logo.png");
logo = logo.Scale(logo.GetWidth() * k, logo.GetHeight() * k);
cx = W / 2;
cy = H * 0.40;
logo_s = Sprite(logo);
logo_s.SetPosition(cx - logo.GetWidth() / 2, cy - logo.GetHeight() / 2, 10);

ring = Image("ring.png");
ring = ring.Scale(ring.GetWidth() * k, ring.GetHeight() * k);
ring_s = Sprite(ring);
ring_s.SetZ(20);

word = Image("word.png");
word = word.Scale(word.GetWidth() * k, word.GetHeight() * k);
word_s = Sprite(word);
word_s.SetPosition(cx - word.GetWidth() / 2, cy + 150 * k, 10);

tag = Image("tagline.png");
tag = tag.Scale(tag.GetWidth() * k, tag.GetHeight() * k);
tag_s = Sprite(tag);
tag_s.SetPosition(cx - tag.GetWidth() / 2, cy + 280 * k, 10);
tag_s.SetOpacity(0);

// contatore del tempo di avvio (la schermata si aggiorna 50 volte al secondo)
time_s = Sprite();
time_s.SetZ(30);
fun show_time(frames) {
  tenths = Math.Int(frames / 5);
  secs = Math.Int(tenths / 10);
  dec = tenths - secs * 10;
  img = Image.Text("avvio  " + secs + "," + dec + " s", 0.75, 0.88, 0.95, 1, "Sans 15");
  time_s.SetImage(img);
  time_s.SetPosition(cx - img.GetWidth() / 2, cy + 350 * k, 30);
}

t = 0;
fun refresh_callback() {
  t++;
  if (t % 5 == 0) show_time(t);
  r = ring.Rotate(t * 0.09);
  ring_s.SetImage(r);
  ring_s.SetPosition(cx - r.GetWidth() / 2, cy - r.GetHeight() / 2, 20);
  // la sfera "respira" leggermente, lo slogan compare piano piano
  logo_s.SetOpacity(0.85 + 0.15 * Math.Sin(t * 0.05));
  if (t < 60) tag_s.SetOpacity(t / 60); else tag_s.SetOpacity(1);
}
Plymouth.SetRefreshFunction(refresh_callback);

// messaggi e password (es. dischi cifrati): testo semplice sotto il logo
msg_s = Sprite();
fun message_callback(text) {
  msg_s.SetImage(Image.Text(text, 0.8, 0.9, 0.95));
  msg_s.SetPosition(cx - msg_s.GetImage().GetWidth() / 2, H * 0.9, 30);
}
Plymouth.SetMessageFunction(message_callback);

pw_s = Sprite();
fun display_password_callback(prompt, bullets) {
  s = prompt + "  ";
  for (i = 0; i < bullets; i++) s += "•";
  pw_s.SetImage(Image.Text(s, 1, 1, 1));
  pw_s.SetPosition(cx - pw_s.GetImage().GetWidth() / 2, H * 0.85, 30);
  pw_s.SetOpacity(1);
}
fun display_normal_callback() { pw_s.SetOpacity(0); }
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
