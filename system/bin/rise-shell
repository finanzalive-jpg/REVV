#!/usr/bin/env python3
"""Rise – il desktop.

Disegna il desktop di Rise con WebKitGTK e fa da ponte verso Linux.
Con un gestore di finestre moderno (labwc) crea:
  - lo sfondo con le icone          (livello "background")
  - la barra delle applicazioni     (livello "top", riserva 52 px in basso)
  - il menu Start e il pannello rapido (livello "overlay", nascosto finché serve)
  - una finestra vera per ogni app di Rise (Impostazioni, Esplora file, …)
Senza gestore di finestre (vecchia sessione cage) apre tutto in un'unica finestra.

Uso: rise-shell                 avvia il desktop
     rise-shell --start         apre o chiude il menu Start (tasto Windows)
     rise-shell --open <app>    apre un'app di Rise (es. files, settings)
"""
import json
import os
import shlex
import shutil
import subprocess
import sys
import threading
import urllib.parse

# La libreria che aggancia barra e sfondo ai bordi dello schermo deve essere caricata
# prima di tutte le altre: se manca, il programma riparte da solo con LD_PRELOAD.
LSLIB = '/usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0'
if os.path.exists(LSLIB) and LSLIB not in os.environ.get('LD_PRELOAD', '') and os.environ.get('RISE_SINGLE') != '1':
    os.environ['LD_PRELOAD'] = (LSLIB + ' ' + os.environ.get('LD_PRELOAD', '')).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

sys.path.insert(0, '/usr/local/lib/rise')
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rise'))

import gi  # noqa: E402
gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')
gi.require_version('WebKit', '6.0')
from gi.repository import Gdk, Gio, GLib, Gtk, WebKit  # noqa: E402

try:
    gi.require_version('Gtk4LayerShell', '1.0')
    from gi.repository import Gtk4LayerShell as LS  # noqa: E402
except (ValueError, ImportError):
    LS = None

import risesys  # noqa: E402

BASE = os.environ.get('RISE_DESKTOP', '/opt/rise/index.html')
BAR_H = 52

# Programmi veri che Rise sa avviare (se installati)
NATIVE = [
    {'id': 'browser', 'name': 'Internet', 'desc': 'Naviga sui siti web', 'icon': 'browser',
     'cmd': ['epiphany-browser'], 'app_ids': ['org.gnome.Epiphany', 'epiphany']},
    {'id': 'word', 'name': 'WordCraft', 'desc': 'Scrivi lettere e documenti (.docx)', 'icon': 'm-word',
     'cmd': ['wordcraft'], 'app_ids': ['ai.storyteller.wordcraft', 'wordcraft']},
    {'id': 'sheet', 'name': 'GridCraft', 'desc': 'Fogli di calcolo e conti (.xlsx)', 'icon': 'm-xls',
     'cmd': ['gridcraft'], 'app_ids': ['ai.storyteller.gridcraft', 'gridcraft']},
    {'id': 'deck', 'name': 'DeckCraft', 'desc': 'Presentazioni (.pptx)', 'icon': 'm-ppt',
     'cmd': ['deckcraft'], 'app_ids': ['ai.storyteller.deckcraft', 'deckcraft']},
    {'id': 'player', 'name': 'Lettore video', 'desc': 'Guarda film e video', 'icon': 'player',
     'cmd': ['mpv', '--player-operation-mode=pseudo-gui'], 'app_ids': ['mpv']},
]


def url_for(**params):
    q = urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
    return 'file://' + BASE + ('?' + q if q else '')


def transparent(widget):
    css = Gtk.CssProvider()
    css.load_from_data(b'window, window.background { background: transparent; }')
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                              Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


class Rise(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='org.rise.Shell',
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.views = {}          # nome -> WebView
        self.windows = {}        # nome -> Gtk.Window
        self.started = False
        self.multi = False
        self.toplevels = None
        self.popup_kind = None
        self.drop = None

    # ---------------- riga di comando ----------------
    def do_command_line(self, cmd):
        args = cmd.get_arguments()[1:]
        if not self.started:
            self.started = True
            self.boot()
        if '--start' in args:
            self.popup_toggle('start')
        elif '--open' in args:
            i = args.index('--open')
            if i + 1 < len(args):
                self.app_open({'id': args[i + 1]})
        return 0

    # ---------------- avvio ----------------
    def boot(self):
        self.hold()
        transparent(None)
        self.multi = LS is not None and LS.is_supported() and os.environ.get('RISE_SINGLE') != '1'
        if not self.multi:
            win = self.make_window('full', url_for(role='full'), Gtk.ApplicationWindow(application=self))
            win.set_decorated(False)
            win.fullscreen()
            win.present()
            return
        # sfondo con le icone
        d = Gtk.Window(application=self)
        LS.init_for_window(d)
        LS.set_layer(d, LS.Layer.BACKGROUND)
        LS.set_namespace(d, 'rise-desktop')
        for e in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
            LS.set_anchor(d, e, True)
        LS.set_exclusive_zone(d, -1)
        LS.set_keyboard_mode(d, LS.KeyboardMode.ON_DEMAND)
        self.make_window('desktop', url_for(role='desktop'), d)
        d.present()
        # barra delle applicazioni
        p = Gtk.Window(application=self)
        LS.init_for_window(p)
        LS.set_layer(p, LS.Layer.TOP)
        LS.set_namespace(p, 'rise-panel')
        for e in (LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
            LS.set_anchor(p, e, True)
        LS.set_exclusive_zone(p, BAR_H)
        p.set_default_size(800, BAR_H)
        self.make_window('panel', url_for(role='panel'), p)
        self.views['panel'].set_size_request(-1, BAR_H)
        p.set_size_request(-1, BAR_H)
        p.present()
        GLib.timeout_add_seconds(4, self.check_panel)
        # menu Start e pannello rapido (sopra a tutto, nascosto)
        o = Gtk.Window(application=self)
        LS.init_for_window(o)
        LS.set_layer(o, LS.Layer.OVERLAY)
        LS.set_namespace(o, 'rise-popup')
        for e in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
            LS.set_anchor(o, e, True)
        LS.set_exclusive_zone(o, -1)
        LS.set_keyboard_mode(o, LS.KeyboardMode.EXCLUSIVE)
        self.make_window('popup', url_for(role='popup'), o)
        # elenco delle finestre aperte
        try:
            from risewl.toplevels import Toplevels
            self.toplevels = Toplevels(lambda lst: GLib.idle_add(self.push_toplevels, lst))
            if not self.toplevels.start():
                self.toplevels = None
        except Exception as e:  # senza elenco finestre la barra mostra solo le app di Rise
            print('elenco finestre non disponibile:', e, file=sys.stderr)
            self.toplevels = None
        # Rise Drop: ricezione file dai dispositivi vicini
        try:
            import risedrop
            self.drop = risedrop.Drop(
                on_devices=lambda lst: GLib.idle_add(self.broadcast, 'window.__riseDropDevices && window.__riseDropDevices(%s)' % json.dumps(lst)),
                on_request=lambda req: GLib.idle_add(self.popup_show, {'kind': 'drop', 'data': req}),
                on_event=lambda ev: GLib.idle_add(self.drop_event, ev))
            if not self.drop.start():
                self.drop = None
        except Exception as e:
            print('Rise Drop non disponibile:', e, file=sys.stderr)
            self.drop = None
        # indice per la ricerca dei file, aggiornato con calma dopo l'avvio
        GLib.timeout_add_seconds(90, self.index_later)

    def check_panel(self):
        # la barra deve essere alta BAR_H: se il sistema l'ha fatta più bassa, la rimette a posto
        p = self.windows.get('panel')
        if p:
            h = p.get_height()
            print('rise-size panel', p.get_width(), 'x', h, 'scale', p.get_scale_factor(), flush=True)
            if h and h < BAR_H:
                p.set_default_size(p.get_width() or 800, BAR_H)
                LS.set_exclusive_zone(p, BAR_H)
                p.queue_resize()
        return False

    def make_window(self, name, uri, win):
        view = WebKit.WebView()
        view.set_background_color(Gdk.RGBA(0, 0, 0, 0))
        s = view.get_settings()
        s.set_allow_file_access_from_file_urls(True)
        s.set_allow_universal_access_from_file_urls(True)
        s.set_enable_developer_extras(True)
        s.set_javascript_can_open_windows_automatically(False)
        if hasattr(s, 'set_enable_write_console_messages_to_stdout'):
            s.set_enable_write_console_messages_to_stdout(True)
        ucm = view.get_user_content_manager()
        ucm.register_script_message_handler('rise', None)
        ucm.connect('script-message-received::rise', self.on_message, name)
        view.connect('context-menu', lambda *a: True)
        view.load_uri(uri)
        win.set_child(view)
        self.views[name] = view
        self.windows[name] = win
        return win

    # ---------------- messaggi dal desktop ----------------
    def on_message(self, _ucm, value, name):
        try:
            msg = json.loads(value.to_json(0))
        except Exception:
            return
        cmd = msg.get('cmd', '')
        args = msg.get('args') or {}
        ui = UI_CMDS.get(cmd)
        if os.environ.get('RISE_DEBUG'):
            safe = {k: ('••••' if 'pass' in k else v) for k, v in args.items()} if isinstance(args, dict) else args
            print('cmd', name, cmd, json.dumps(safe)[:200], file=sys.stderr, flush=True)
        if ui:  # comandi dell'interfaccia: subito, nel thread principale
            try:
                res = {'data': ui(self, args, name)}
            except Exception as e:
                res = {'error': str(e)}
            self.reply(name, msg.get('id', 0), res)
            return
        threading.Thread(target=self.run_cmd, args=(name, msg), daemon=True).start()

    def run_cmd(self, name, msg):
        fn = risesys.CMDS.get(msg.get('cmd'))
        try:
            res = {'data': fn(msg.get('args') or {})} if fn else {'error': 'comando sconosciuto'}
        except Exception as e:
            res = {'error': str(e)}
        GLib.idle_add(self.reply, name, msg.get('id', 0), res)

    def reply(self, name, mid, res):
        self.js(name, 'window.__riseReply(%d, %s)' % (int(mid), json.dumps(res)))
        return False

    def js(self, name, code):
        v = self.views.get(name)
        if v:
            v.evaluate_javascript(code, -1, None, None, None, None, None)

    def broadcast(self, code, skip=None):
        for n in list(self.views):
            if n != skip:
                self.js(n, code)

    # ---------------- finestre ----------------
    def push_toplevels(self, lst):
        mine = {}
        for n, w in self.windows.items():
            if n.startswith('app:'):
                mine[w.get_title() or ''] = n[4:]
        out = []
        for t in lst:
            t = dict(t)
            if t['app_id'] == 'org.rise.Shell':
                t['rise'] = mine.get(t['title'])
            else:
                for a in NATIVE:
                    if t['app_id'] in a['app_ids'] or t['app_id'].lower().startswith(a['id']):
                        t['native'] = a['id']
            out.append(t)
        self.js('panel', 'window.__riseToplevels && window.__riseToplevels(%s)' % json.dumps(out))
        return False

    def app_open(self, a, _name=None):
        aid = str(a.get('id', ''))
        key = 'app:' + aid
        if key in self.windows:
            w = self.windows[key]
            w.present()
            if a.get('goto') is not None:
                self.js(key, 'window.__riseGoto && window.__riseGoto(%s)' % json.dumps(a.get('goto')))
            return {'ok': True}
        if not self.multi:
            return {'ok': False}
        w = Gtk.Window(application=self)
        w.set_decorated(False)
        w.set_title(a.get('title') or aid)
        w.set_default_size(int(a.get('w', 820)), int(a.get('h', 560)))
        goto = a.get('goto')
        self.make_window(key, url_for(role='app', app=aid,
                                      goto=json.dumps(goto) if goto is not None else None), w)

        def gone(*_):
            self.windows.pop(key, None)
            self.views.pop(key, None)
            return False
        w.connect('close-request', gone)
        w.present()
        return {'ok': True}

    def _surface_args(self, name, a):
        w = self.windows.get(name)
        if not w:
            return None, None
        seat = Gdk.Display.get_default().get_default_seat()
        return w, seat.get_pointer() if seat else None

    def win_move(self, a, name):
        w, dev = self._surface_args(name, a)
        if w and dev and w.get_surface():
            w.get_surface().begin_move(dev, 1, float(a.get('x', 0)), float(a.get('y', 0)), Gdk.CURRENT_TIME)
        return {'ok': True}

    EDGES = {'n': Gdk.SurfaceEdge.NORTH, 's': Gdk.SurfaceEdge.SOUTH, 'e': Gdk.SurfaceEdge.EAST,
             'w': Gdk.SurfaceEdge.WEST, 'ne': Gdk.SurfaceEdge.NORTH_EAST, 'nw': Gdk.SurfaceEdge.NORTH_WEST,
             'se': Gdk.SurfaceEdge.SOUTH_EAST, 'sw': Gdk.SurfaceEdge.SOUTH_WEST}

    def win_resize(self, a, name):
        w, dev = self._surface_args(name, a)
        edge = self.EDGES.get(a.get('edge', 'se'))
        if w and dev and edge is not None and w.get_surface():
            w.get_surface().begin_resize(edge, dev, 1, float(a.get('x', 0)), float(a.get('y', 0)), Gdk.CURRENT_TIME)
        return {'ok': True}

    def win_state(self, a, name):
        w = self.windows.get(name)
        if not w:
            return {'ok': False}
        act = a.get('action')
        if act == 'min':
            w.minimize()
        elif act == 'max':
            w.unmaximize() if w.is_maximized() else w.maximize()
        elif act == 'close':
            w.close()
        elif act == 'title':
            w.set_title(str(a.get('title', '')))
        return {'ok': True, 'maximized': w.is_maximized()}

    # ---------------- menu Start / pannello rapido ----------------
    def popup_toggle(self, kind):
        if self.popup_kind == kind:
            self.popup_hide()
        else:
            self.popup_show({'kind': kind})

    def popup_show(self, a, _name=None):
        o = self.windows.get('popup')
        if not o:
            return {'ok': False}
        self.popup_kind = a.get('kind', 'start')
        o.present()
        self.js('popup', 'window.__risePopup && window.__risePopup(%s, %s)' % (json.dumps(self.popup_kind), json.dumps(a.get('data'))))
        self.js('panel', 'window.__risePopupState && window.__risePopupState(%s)' % json.dumps(self.popup_kind))
        return {'ok': True}

    def popup_hide(self, _a=None, _name=None):
        o = self.windows.get('popup')
        if o:
            o.set_visible(False)
        self.popup_kind = None
        self.js('panel', 'window.__risePopupState && window.__risePopupState(null)')
        return {'ok': True}

    # ---------------- programmi veri ----------------
    def native_list(self, _a=None, _name=None):
        return [dict(n, installed=bool(shutil.which(n['cmd'][0]))) for n in NATIVE]

    def native_open(self, a, _name=None):
        nid = a.get('id')
        app = next((n for n in NATIVE if n['id'] == nid), None)
        cmd = list(app['cmd']) if app else None
        if not cmd or not shutil.which(cmd[0]):
            return {'ok': False, 'message': 'Programma non installato.'}
        if a.get('path'):
            cmd.append(a['path'])
        if a.get('url'):
            cmd.append(a['url'])
        env = dict(os.environ)
        env.pop('LD_PRELOAD', None)
        subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
        return {'ok': True}

    def top_action(self, a, _name=None):
        if not self.toplevels:
            return {'ok': False}
        act, tid = a.get('action'), a.get('id')
        ok = {'activate': self.toplevels.activate, 'minimize': self.toplevels.minimize,
              'close': self.toplevels.close}.get(act, lambda _t: False)(tid)
        return {'ok': ok}

    def state_changed(self, a, name):
        self.broadcast('window.__riseSync && window.__riseSync(%s)' % json.dumps(a.get('state') or {}), skip=name)
        return {'ok': True}

    # ---------------- Rise Drop ----------------
    def drop_event(self, ev):
        if ev.get('type') == 'received':
            self.popup_show({'kind': 'dropdone', 'data': ev})
        self.broadcast('window.__riseDropEvent && window.__riseDropEvent(%s)' % json.dumps(ev))
        return False

    def drop_cmd(self, a, name):
        if not self.drop:
            return {'ok': False, 'message': 'Rise Drop non è attivo.'}
        act = a.get('action')
        if act == 'devices':
            return {'ok': True, 'devices': self.drop.list_devices(), 'conf': self.drop.conf}
        if act == 'scan':
            return {'ok': True, 'devices': self.drop.scan(), 'conf': self.drop.conf}
        if act == 'answer':
            return {'ok': self.drop.answer(a.get('id'), a.get('accept'))}
        if act == 'conf':
            return {'ok': True, 'conf': self.drop.save_conf(a.get('alias'), a.get('receive'))}
        if act == 'send':
            def work():
                res = self.drop.send(a.get('device'), a.get('paths') or [],
                                     progress=lambda p: GLib.idle_add(self.js, name, 'window.__riseDropProgress && window.__riseDropProgress(%s)' % json.dumps(p)))
                GLib.idle_add(self.js, name, 'window.__riseDropProgress && window.__riseDropProgress(%s)' % json.dumps(dict(res, stage='done')))
            threading.Thread(target=work, daemon=True).start()
            return {'ok': True}
        return {'ok': False}

    def index_later(self):
        threading.Thread(target=lambda: risesys.index_update({}), daemon=True).start()
        GLib.timeout_add_seconds(3600, self.index_later)
        return False

    def open_with(self, a, _name=None):
        # apre un file col programma giusto: video e musica col lettore, Office con i Craft
        path = a.get('path') or ''
        ext = os.path.splitext(path)[1].lower()
        table = {'.docx': 'word', '.doc': 'word', '.odt': 'word', '.rtf': 'word', '.xlsx': 'sheet', '.xls': 'sheet',
                 '.ods': 'sheet', '.csv': 'sheet', '.pptx': 'deck', '.ppt': 'deck', '.odp': 'deck',
                 '.mp4': 'player', '.mkv': 'player', '.avi': 'player', '.mov': 'player', '.webm': 'player',
                 '.mp3': 'player', '.flac': 'player', '.ogg': 'player', '.wav': 'player', '.m4a': 'player',
                 '.html': 'browser', '.htm': 'browser'}
        nid = a.get('app') or table.get(ext)
        if not nid:
            return {'ok': False}
        return self.native_open({'id': nid, 'path': path})

    def info(self, _a, name):
        return {'multi': self.multi, 'toplevels': bool(self.toplevels), 'role': name}


UI_CMDS = {
    'app.open': Rise.app_open, 'win.move': Rise.win_move, 'win.resize': Rise.win_resize,
    'win.state': Rise.win_state, 'popup.show': Rise.popup_show, 'popup.hide': Rise.popup_hide,
    'native.list': Rise.native_list, 'native.open': Rise.native_open, 'top.action': Rise.top_action,
    'state.changed': Rise.state_changed, 'shell.info': Rise.info, 'drop': Rise.drop_cmd,
    'open.with': Rise.open_with,
}

if __name__ == '__main__':
    sys.exit(Rise().run(sys.argv))
